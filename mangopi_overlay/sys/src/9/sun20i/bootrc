#!/bin/rc
ramfs -m /tmp

echo -n adm >/dev/hostowner
bind -a '#S' /dev
bind -a '#p' /proc
disk/fdisk -p /dev/sdM0/data >/dev/sdM0/ctl
disk/prep -p /dev/sdM0/plan9 >/dev/sdM0/ctl
hjfs -f /dev/sdM0/fs
mount -c /srv/hjfs /n

echo 4096 >/env/profsize

aux/kbdfs -q '#t/eia0' >'#t/eia0'
exec /bin/rc -i </dev/cons >/dev/cons >[2]/dev/cons
